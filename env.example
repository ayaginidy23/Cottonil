# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL (Docker)
POSTGRES_USER=cottonil
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cottonil
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# pgAdmin (http://localhost:5055)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# LLM - Google Gemini through the OpenAI-compatible API
# Several keys can be given separated by commas: key1,key2
LLM_API_KEY=your_gemini_api_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
LLM_EMBED_MODEL=gemini-embedding-001
